__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
target/
_vender/
src/bosn/_native.*

# Only the project cargo config is tracked; a tool that treats .cargo as
# CARGO_HOME must never get its registry or caches committed.
/.cargo/*
!/.cargo/config.toml

# clud agent scratch (logs, tmp, caches) lives inside the checkout and is not
# source. Without this the local gate refuses a PR as a dirty worktree.
.clud/
