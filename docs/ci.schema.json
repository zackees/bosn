{
  "$defs": {
    "BaseRef": {
      "additionalProperties": false,
      "description": "The branch a local pull request targets, at its commit in the workspace.",
      "properties": {
        "branch": {
          "description": "`pull_request.base.ref`, e.g. `main`.",
          "type": "string"
        },
        "sha": {
          "description": "`pull_request.base.sha`: the branch's commit when the run was taken.",
          "type": "string"
        }
      },
      "required": [
        "branch",
        "sha"
      ],
      "type": "object"
    },
    "CacheUsage": {
      "description": "The machine-wide cache volume (act tools, runner image, action\ncheckouts and the per-repository `actions/cache` store).",
      "properties": {
        "bytes": {
          "description": "`None` when the volume does not exist.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "volume": {
          "type": "string"
        }
      },
      "required": [
        "volume"
      ],
      "type": "object"
    },
    "CancelReply": {
      "properties": {
        "cancelled": {
          "type": "boolean"
        },
        "run": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "run",
        "cancelled",
        "state"
      ],
      "type": "object"
    },
    "CiRequest": {
      "description": "Every CI operation. Each maps to one typed handler; there is no generic\ncommand surface.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "submit",
              "type": "string"
            },
            "request": {
              "$ref": "#/$defs/SubmitRequest"
            }
          },
          "required": [
            "op",
            "request"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "op": {
              "const": "list",
              "type": "string"
            },
            "state": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunState"
                },
                {
                  "type": "null"
                }
              ]
            },
            "workspace": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "show",
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "tree": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "run"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "job": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "max_bytes": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "op": {
              "const": "logs",
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "section": {
              "type": [
                "string",
                "null"
              ]
            },
            "since_seq": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "run"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "cancel",
              "type": "string"
            },
            "run": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "run"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "job": {
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "const": "retry",
              "type": "string"
            },
            "run": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "run"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "report",
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "tail": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "run"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/RunnerAction"
            },
            "op": {
              "const": "runners",
              "type": "string"
            }
          },
          "required": [
            "op",
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A widget process starting (`explicit` = typed by the user).",
          "properties": {
            "explicit": {
              "type": "boolean"
            },
            "op": {
              "const": "widget_hello",
              "type": "string"
            },
            "pid": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "session": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "pid",
            "session",
            "explicit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The widget's heartbeat; the reply carries its pending commands.",
          "properties": {
            "op": {
              "const": "widget_poll",
              "type": "string"
            },
            "pid": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "pid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A deliberate quit from the widget's menu.",
          "properties": {
            "op": {
              "const": "widget_dismiss",
              "type": "string"
            },
            "session": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "session"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Queue a command for the widget (from the dashboard or `bosn ui`).",
          "properties": {
            "command": {
              "$ref": "#/$defs/WidgetCommand"
            },
            "op": {
              "const": "widget_command",
              "type": "string"
            }
          },
          "required": [
            "op",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A single-use dashboard link (only from the owner-only socket).",
          "properties": {
            "op": {
              "const": "ui_grant",
              "type": "string"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        }
      ]
    },
    "Conclusion": {
      "description": "Run conclusion. Exit codes: success 0, failure/error 1,\ncancelled/timed_out 2, refused/incomplete 3.",
      "oneOf": [
        {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "timed_out",
            "refused"
          ],
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Some jobs could not run here, or none succeeded; never a pass.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "The engine or its cleanup failed; never a pass.",
          "type": "string"
        }
      ]
    },
    "ErrorReply": {
      "description": "A refused or failed request. `code` is stable (`refused`, `not_found`,\n`invalid_request`, `internal`).",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "FailureReport": {
      "properties": {
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "job": {
          "type": "string"
        },
        "job_name": {
          "type": "string"
        },
        "section": {
          "description": "`<stage>:<step id>`, usable as `ci logs --step`.",
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "tail": {
          "description": "The last lines of that one step only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "job",
        "job_name",
        "tail"
      ],
      "type": "object"
    },
    "Group": {
      "properties": {
        "jobs": {
          "items": {
            "$ref": "#/$defs/Job"
          },
          "type": "array"
        },
        "name": {
          "description": "GitHub: the `needs:` stage index; GitLab: the stage name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "jobs"
      ],
      "type": "object"
    },
    "ItemConclusion": {
      "description": "Outcome of one job or section once completed.",
      "oneOf": [
        {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped"
          ],
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The job needs a runner bosn cannot supervise (`runs-on: macos-*`).",
          "type": "string"
        },
        {
          "const": "remote_only",
          "description": "The job can only run on GitHub (GATE-012): not run locally, never a\nfailure and never a coverage gap.",
          "type": "string"
        }
      ]
    },
    "ItemStatus": {
      "description": "Lifecycle of one job or section.",
      "enum": [
        "queued",
        "in_progress",
        "completed"
      ],
      "type": "string"
    },
    "Job": {
      "properties": {
        "conclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemConclusion"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "description": "Workflow job ID shared by matrix legs.",
          "type": "string"
        },
        "key": {
          "description": "Unique per run: GitHub job x matrix leg (act's `job` field).",
          "type": "string"
        },
        "matrix": true,
        "name": {
          "type": "string"
        },
        "reason": {
          "description": "Why the job did not run locally (a `remote_only` job's reason).",
          "type": [
            "string",
            "null"
          ]
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        }
      },
      "required": [
        "key",
        "job_id",
        "name",
        "status",
        "sections"
      ],
      "type": "object"
    },
    "JobCounts": {
      "properties": {
        "completed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "completed",
        "failed"
      ],
      "type": "object"
    },
    "JobOutcomes": {
      "properties": {
        "cancelled": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "remote_only": {
          "default": [],
          "description": "Jobs only GitHub can run (GATE-012): not run locally, never a failure\nand never a coverage gap.",
          "items": {
            "$ref": "#/$defs/RemoteOnlyJob"
          },
          "type": "array"
        },
        "skipped": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "succeeded": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unsupported": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "succeeded",
        "failed",
        "cancelled",
        "skipped",
        "unsupported"
      ],
      "type": "object"
    },
    "ListReply": {
      "properties": {
        "runners": {
          "$ref": "#/$defs/RunnerStatus"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunView"
          },
          "type": "array"
        }
      },
      "required": [
        "runs",
        "runners"
      ],
      "type": "object"
    },
    "LogRecord": {
      "description": "One persisted log record. `seq` is the run-wide, gap-free cursor space.",
      "properties": {
        "job": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "description": "`stdout`, `stderr` or `bosn` (daemon lifecycle notes).",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "stream",
        "text"
      ],
      "type": "object"
    },
    "LogsReply": {
      "properties": {
        "done": {
          "description": "The run finished: no further records will appear.",
          "type": "boolean"
        },
        "more": {
          "description": "More records are available now.",
          "type": "boolean"
        },
        "next_seq": {
          "description": "Cursor for the next call (`since_seq`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/LogRecord"
          },
          "type": "array"
        },
        "run": {
          "type": "string"
        },
        "total_records": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "run",
        "records",
        "next_seq",
        "total_records",
        "more",
        "done"
      ],
      "type": "object"
    },
    "Mode": {
      "description": "How much of the CI to run (fleet `ci-test`/`ci-full` tiers).",
      "enum": [
        "minimal",
        "test",
        "full"
      ],
      "type": "string"
    },
    "Plan": {
      "description": "What `bosn ci run` would execute (`bosn ci plan`).",
      "properties": {
        "actor": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "engine": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "job": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "payload": {
          "description": "The provider event payload, as act receives it."
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "repository": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sha": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "workflow": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workspace",
        "provider",
        "engine",
        "workflow",
        "trigger",
        "mode",
        "event",
        "payload",
        "repository",
        "sha",
        "dirty",
        "actor"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "The CI syntax: GitHub workflows now, `.gitlab-ci.yml` later.",
      "enum": [
        "github",
        "gitlab"
      ],
      "type": "string"
    },
    "RemoteOnlyJob": {
      "description": "A job reported `remote_only`, and why act cannot run it.",
      "properties": {
        "job": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "job",
        "reason"
      ],
      "type": "object"
    },
    "RunEvent": {
      "oneOf": [
        {
          "description": "A run's state, conclusion or progress changed.",
          "properties": {
            "actor": {
              "type": "string"
            },
            "conclusion": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Conclusion"
                },
                {
                  "type": "null"
                }
              ]
            },
            "jobs": {
              "$ref": "#/$defs/JobCounts"
            },
            "log_records": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "run": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/RunState"
            },
            "type": {
              "const": "run",
              "type": "string"
            },
            "workspace": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "run",
            "state",
            "log_records",
            "jobs",
            "actor",
            "workspace"
          ],
          "type": "object"
        },
        {
          "description": "This reader missed `skipped` events: refetch everything.",
          "properties": {
            "skipped": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "resync",
              "type": "string"
            }
          },
          "required": [
            "type",
            "skipped"
          ],
          "type": "object"
        }
      ]
    },
    "RunReport": {
      "description": "The `ci report --json` agent contract.",
      "properties": {
        "actor": {
          "type": "string"
        },
        "cleanup": {
          "type": [
            "string",
            "null"
          ]
        },
        "conclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Conclusion"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_complete": {
          "description": "False when any job needed a runner bosn cannot supervise.",
          "type": "boolean"
        },
        "dirty": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "first_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "jobs": {
          "$ref": "#/$defs/JobOutcomes"
        },
        "logs_command": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sha": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "ui_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run",
        "state",
        "sha",
        "workflow",
        "trigger",
        "mode",
        "actor",
        "jobs",
        "coverage_complete",
        "logs_command"
      ],
      "type": "object"
    },
    "RunState": {
      "description": "Where a run is in its life.",
      "enum": [
        "queued",
        "running",
        "done"
      ],
      "type": "string"
    },
    "RunTree": {
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/Group"
          },
          "type": "array"
        },
        "malformed_lines": {
          "description": "Lines that were not valid provider records (counted, never fatal).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "groups",
        "malformed_lines"
      ],
      "type": "object"
    },
    "RunView": {
      "description": "A run as clients see it: the record plus fields derived from it. Listings\nomit the job tree (`record.tree` is then empty).",
      "properties": {
        "act_exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "act_version": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "cleanup": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "default": null,
          "description": "The synthetic commit the job checked out when `dirty`: `sha` plus the\nuncommitted work, so a workflow cleaning its tree still builds it.",
          "type": [
            "string",
            "null"
          ]
        },
        "conclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Conclusion"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "format": "double",
          "type": "number"
        },
        "dirty": {
          "description": "Tree digest when the run used uncommitted work (`sha + dirty`).",
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "type": "string"
        },
        "engine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": "string"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
